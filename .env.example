# Copia este archivo a .env y ajusta los valores.
# NUNCA subas .env al repositorio.

# --- PostgreSQL + pgvector ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=kos
POSTGRES_USER=kos
POSTGRES_PASSWORD=kos_dev_password

# --- Neo4j ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=kos_dev_password

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- MinIO (S3 compatible) ---
MINIO_ENDPOINT=localhost:9000
MINIO_ROOT_USER=kos
MINIO_ROOT_PASSWORD=kos_dev_password
MINIO_BUCKET=kos-documents
# true contra R2/S3 gestionado (doc 14 §7): sin esquema en MINIO_ENDPOINT,
# solo host[:puerto] — el SDK de MinIO decide http/https con este flag.
MINIO_SECURE=false

# --- Ollama ---
# En Mac se usa el Ollama nativo (brew install ollama), no el de Docker:
# el servicio "ollama" del compose queda bajo el perfil opcional "ollama-docker".
# Modelo LLM local: llama3.2 (~2 GB) es ligero; qwen2.5:latest (~4.7 GB) da mejor
# calidad si la máquina lo aguanta.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LLM_MODEL=llama3.2:latest
OLLAMA_EMBEDDING_MODEL=bge-m3

# --- Fuentes de conocimiento ---
# Ruta al vault de Obsidian (conector inicial)
OBSIDIAN_VAULT_PATH=

# --- Herramientas externas (ResearchAgent, Sprint 20, doc 06 §4) ---
# GitHub: opcional, sin token la API pública funciona con cuota más baja.
GITHUB_TOKEN=
# Brave Search API (https://brave.com/search/api/): requerida para web.search/web.open.
# Sin key, esas dos tools devuelven un error claro en vez de fallar en silencio.
BRAVE_SEARCH_API_KEY=

# --- Aplicación ---
KOS_ENV=development
KOS_LOG_LEVEL=INFO

# --- LLM cloud opt-in (ADR-0007): solo Planner y WritingAgent ---
# Ruta cloud APAGADA por defecto: con "ollama" todo sigue local (ADR-0006) y
# el resto de este bloque se ignora. Ponla en "openai" solo para la tarea que
# quieras acelerar. Con "openai" pero sin OPENAI_API_KEY se cae a Ollama.
KOS_PLANNER_LLM_PROVIDER=ollama
KOS_WRITING_LLM_PROVIDER=ollama
# Requerida solo si algún provider de arriba es "openai". https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_LLM_MODEL=gpt-4o-mini
# Vacío = API de OpenAI. Solo se rellena para un gateway compatible (LiteLLM, Azure...).
OPENAI_BASE_URL=
# A dónde el SDK manda las métricas del path cloud (tokens/coste/latencia). Vacío
# = no se audita. Instancia self-hosted: http://localhost:3002 (make llm-obs-up);
# o la URL pública de tu despliegue en Railway.
LLM_OBSERVATORY_URL=
# Token obs_sk_... del dashboard de llm-observatory (se crea con la cuenta). Vacío
# está bien si tu instancia no exige auth en /api/metrics.
LLM_OBSERVATORY_TOKEN=

# --- llm-observatory self-hosted (perfil docker "llm-observatory", make llm-obs-up) ---
# Solo si vas a levantar la instancia localmente. Genera cada secreto con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"   # ENCRYPTION_KEY
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"   # JWT_SECRET
LLM_OBS_ENCRYPTION_KEY=
LLM_OBS_JWT_SECRET=
LLM_OBS_PG_USER=observatory
LLM_OBS_PG_PASSWORD=observatory_dev_password
LLM_OBS_PG_DB=llm_observatory
LLM_OBS_API_PORT=3002
LLM_OBS_WEB_PORT=3003
LLM_OBS_PG_PORT=5433
LLM_OBS_DISCORD_WEBHOOK_URL=

# --- Ahorro de recursos (doc 09 §8) ---
# Apaga Postgres/Neo4j/Redis/MinIO tras KOS_IDLE_STOP_MINUTES sin consultas
# y los enciende solo al llegar una consulta real (/health y /metrics no
# cuentan). Requiere correr `make guardian-watch` en paralelo al API
# (ya incluido en `make dev`); si no, nada apaga nada.
KOS_GUARDIAN_ENABLED=false
KOS_IDLE_STOP_MINUTES=20

# --- Despliegue gestionado en Railway (doc 14; ADR-0008/0009/0010) ---
# Todo esto va vacío en local: el modo local-first no necesita ninguna.

# Postgres gestionado (Supabase, Railway...): una URL completa, con su sslmode.
# Si está puesta, gana sobre POSTGRES_HOST/PORT/DB/USER/PASSWORD.
DATABASE_URL=
# Railway duerme un servicio solo si no emite tráfico saliente (doc 14 §2.2):
# con esto los pools no dejan conexiones ociosas abiertas.
KOS_SERVERLESS_MODE=false

# Autenticación (ADR-0010): claves nombradas `nombre:clave` separadas por comas.
# El navegador las presenta por Basic (usuario = nombre); la Mac y el CLI, por
# cabecera X-API-Key. Vacío = solo se aceptan conexiones locales.
KOS_API_KEYS=
KOS_RATE_LIMIT_PER_MINUTE=120
KOS_RATE_LIMIT_LLM_PER_MINUTE=20

# Cadena de proveedores LLM (ADR-0008): se intentan en orden y, agotada, el
# error sube. Vacía = comportamiento por tarea de ADR-0007.
KOS_LLM_PROVIDER_CHAIN=
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_LLM_MODEL=openai/gpt-4o-mini
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_LLM_MODEL=llama-3.3-70b-versatile
# Cualquier otro proveedor con wire format de OpenAI (DeepSeek, Together,
# Fireworks, vLLM local) se usa sin código: basta OPENAI_BASE_URL + su clave
# (doc 15 §2.1). Su coste se audita como cost_confidence=unknown.

# Embeddings (ADR-0008): sigue siendo bge-m3 a 1024 dimensiones — cambiarlo
# obligaría a re-embeder todo y migrar el schema (ADR-0002). Solo cambia quién
# lo sirve: `ollama` (local) u `openai_compatible` (endpoint hospedado).
KOS_EMBEDDING_PROVIDER=ollama
KOS_EMBEDDING_BASE_URL=
KOS_EMBEDDING_API_KEY=
KOS_EMBEDDING_MODEL=bge-m3

# Disparo inmediato del drain (doc 14 §5): la API pide a Railway que ejecute
# ahora el servicio cron, que es quien tiene el vault en su volumen.
RAILWAY_API_TOKEN=
RAILWAY_CRON_SERVICE_ID=
RAILWAY_ENVIRONMENT_ID=
KOS_SYNC_NOW_PER_HOUR=4
# Horas sin ejecución del cron tras las que /v1/ops/status avisa (cron 2x/día).
KOS_CRON_STALE_HOURS=18
# La API del despliegue gestionado no tiene el filesystem del vault (doc 14 §5):
# las escrituras se encolan y las materializa el drain. `true` solo en el
# servicio `api`; el servicio cron escribe directo.
KOS_DEFER_VAULT_WRITES=false
# Clon del vault en el volumen del servicio cron, y build estático del web.
VAULT_PATH=
KOS_WEB_DIST=
