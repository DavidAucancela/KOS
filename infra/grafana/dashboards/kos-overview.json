{
  "title": "KOS Overview",
  "uid": "kos-overview",
  "editable": true,
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-24h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Salud",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 2,
      "title": "Business metrics up",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 1 },
      "targets": [{ "expr": "kos_business_metrics_up", "refId": "A" }],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "title": "API up",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 1 },
      "targets": [{ "expr": "up{job=\"kos-api\"}", "refId": "A" }],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "title": "Workers up",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 1 },
      "targets": [{ "expr": "up{job=\"kos-workers\"}", "refId": "A" }],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "title": "Horas desde el último Recomendador",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 1 },
      "targets": [
        {
          "expr": "(time() - kos_recommender_last_run_timestamp_seconds) / 3600",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "h",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 24 },
              { "color": "red", "value": 72 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 10,
      "title": "Planner",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 11,
      "title": "Planes generados",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "targets": [{ "expr": "kos_plans", "legendFormat": "{{window}}", "refId": "A" }]
    },
    {
      "id": 12,
      "title": "Planes degradados por razón",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "targets": [
        {
          "expr": "kos_plans_degraded",
          "legendFormat": "{{window}} / {{reason}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 13,
      "title": "Latencia promedio de un plan (ms)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "targets": [
        { "expr": "kos_plan_latency_avg_ms", "legendFormat": "{{window}}", "refId": "A" }
      ]
    },
    {
      "id": 14,
      "title": "Pasos por agente",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
      "targets": [
        {
          "expr": "kos_plan_agent_steps",
          "legendFormat": "{{window}} / {{agent}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 15,
      "title": "Latencia promedio por agente (ms)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 22 },
      "targets": [
        {
          "expr": "kos_plan_agent_latency_avg_ms",
          "legendFormat": "{{window}} / {{agent}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 20,
      "title": "Recomendador",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 30 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 21,
      "title": "Recomendaciones por tipo/estado",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 31 },
      "targets": [
        {
          "expr": "kos_recommendations",
          "legendFormat": "{{type}} / {{status}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 22,
      "title": "Recomendaciones creadas (7d/30d)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 31 },
      "targets": [
        {
          "expr": "kos_recommendations_created",
          "legendFormat": "{{window}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 23,
      "title": "Pasadas del Recomendador por estado",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 39 },
      "targets": [
        {
          "expr": "kos_recommender_runs",
          "legendFormat": "{{window}} / {{status}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 24,
      "title": "Días sin recomendaciones nuevas",
      "type": "stat",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 39 },
      "targets": [
        {
          "expr": "(time() - kos_recommendation_last_created_timestamp_seconds) / 86400",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "d",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 7 },
              { "color": "red", "value": 14 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 30,
      "title": "Proceso",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 47 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 31,
      "title": "Documentos ingeridos / retirados por conector",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 48 },
      "targets": [
        {
          "expr": "rate(kos_documents_ingested_total[5m])",
          "legendFormat": "ingeridos / {{connector}}",
          "refId": "A"
        },
        {
          "expr": "rate(kos_documents_retired_total[5m])",
          "legendFormat": "retirados / {{connector}}",
          "refId": "B"
        }
      ]
    },
    {
      "id": 32,
      "title": "Duración de pipeline por conector (p95)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 48 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(kos_pipeline_duration_seconds_bucket[5m])) by (le, connector))",
          "legendFormat": "{{connector}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 33,
      "title": "Tokens LLM por modelo/operación",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 56 },
      "targets": [
        {
          "expr": "rate(kos_llm_tokens_total[5m])",
          "legendFormat": "{{model}} / {{operation}} / {{kind}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 34,
      "title": "Latencia HTTP (p95) por ruta",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 56 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(kos_http_request_duration_seconds_bucket[5m])) by (le, route))",
          "legendFormat": "{{route}}",
          "refId": "A"
        }
      ]
    }
  ]
}
