{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile"
  },
  "deploy": {
    "startCommand": "sh -c 'uvicorn kos_api.main:app --host 0.0.0.0 --port ${PORT:-8000}'",
    "releaseCommand": "alembic -c packages/core/alembic.ini upgrade head",
    "healthcheckPath": "/health",
    "restartPolicyType": "ON_FAILURE",
    "numReplicas": 1
  }
}
